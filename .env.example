# =============================================================================
# Settlement reminder pipeline. Copy to ".env" and fill in. NEVER commit the .env.
# Every value below is a placeholder; the demo needs none of them.
# =============================================================================

# --- Demo ------------------------------------------------------------------------
# true = fixture mailbox, recorded readings, e-mails written to .demo/outbox, no network
DEMO_MODE=true
# Pins "today" (the demo defaults to 2026-09-17, the day the fixtures are built around)
REFERENCE_DATE=

# --- Cycle -----------------------------------------------------------------------
# Preventive reminder N BUSINESS days before the due date
DAYS_BEFORE_DUE=3
# Post-due collection: every N BUSINESS days, up to the cap; then the installment
# ESCALATES to the lawyer and the automation stops collecting it. Cap 0 = collection off.
COLLECTION_INTERVAL_BUSINESS_DAYS=2
COLLECTION_MAX_ATTEMPTS=5
# Missed run recovery (the machine was off on the target day): the reminder still goes
# out up to N calendar days later, on a business day, never after the due date. 0 = off.
CATCHUP_DAYS=2
# Reminders and collections as REPLIES in the notice's conversation (one thread per
# agreement). Needs Mail.ReadWrite on the Graph app; without it, falls back to new messages.
THREAD_REPLIES=true
TIMEZONE=America/Sao_Paulo
# National holidays + the state of the firm (ISO code of the Brazilian state)
HOLIDAY_SUBDIVISION=GO
# true = simulate everything, send no e-mail (a simulation never consumes the real send)
DRY_RUN=true

# --- Sources ---------------------------------------------------------------------
# Comma separated: notices,excel,sharepoint
#   notices    = agreements registered from the notice e-mails (production)
#   excel      = a local spreadsheet (tests, small teams)
#   sharepoint = a SharePoint list through Graph
SOURCES=notices,excel
EXCEL_PATH=fixtures/agreements.xlsx

# --- SharePoint (when SOURCES includes "sharepoint") ---------------------------------
# Site as hostname:/sites/SiteName
SHAREPOINT_SITE=
SHAREPOINT_LIST=

# --- Microsoft 365 / Graph (e-mail and SharePoint) -----------------------------------
# App registration with application permissions Mail.Send + Mail.Read (+ Mail.ReadWrite
# for threaded replies); see docs/GRAPH_SETUP.md
MS_TENANT_ID=
MS_CLIENT_ID=
MS_CLIENT_SECRET=
# The sending mailbox (the automation's account)
MS_SENDER=automation@lawfirm.example
FIRM_NAME=Example Law Firm
SENDER_NAME=
# Signature of the e-mails to the client ("Atenciosamente, <department>"; never a person)
SIGNATURE_DEPARTMENT=Controladoria Jurídica

# --- Ingestion mailbox ---------------------------------------------------------------
# The mailbox the team sends notices/drafts to and clients reply to. Empty = no sweep.
INGEST_MAILBOX=automation@lawfirm.example
INGEST_LOOKBACK_DAYS=7
# Only these sender suffixes may submit NOTICES and DRAFTS (client replies are not affected)
INGEST_ALLOWED_SENDERS=@lawfirm.example
# The firm's domain: internal addresses are never client addresses; lawyers may forward receipts
INTERNAL_DOMAIN=lawfirm.example

# --- Model (receipt reading; legacy draft extraction and recipient matching) ------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# --- Client directory (name -> e-mails), a spreadsheet export --------------------------
CLIENT_DIRECTORY_PATH=fixtures/clients.xlsx

# --- Copies and alerts ---------------------------------------------------------------
# The daily exceptions digest and failure alerts
ALERT_EMAILS=operator@lawfirm.example
# Controllership (awareness, not approval): Cc of everything to the client + confirmations + escalations
CONTROLLERSHIP_EMAILS=controllership@lawfirm.example
# Extra Cc of the NOTICES and the preventive reminders only (never of collections)
CC_NOTICES=labour@lawfirm.example
# Extra copies BY PAYER, in reminders and collections of every agreement whose payer
# contains the key (substring, accent/case insensitive). "key: a@x; other key: b@y"
CC_BY_PAYER=

# --- State ---------------------------------------------------------------------------
# SQLite with agreements, settlements, holds, processed messages and the send history.
# PERSISTENT: back it up. The demo uses .demo/state.sqlite.
HISTORY_DB=data/history.sqlite
